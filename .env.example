# Google Cloud OAuth Web client
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback
APP_BASE_URL=http://localhost:3000

# Neon Postgres connection string (use the pooled connection string for Vercel)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate a random 32-byte key and base64-encode it for OAuth refresh-token encryption.
# Example generation (PowerShell): [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
APP_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-secret
